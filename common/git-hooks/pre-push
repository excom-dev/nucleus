#!/usr/bin/env bash
set -euo pipefail

# Refuse to push a commit whose author / committer identity was guessed by git
# from the operating system (login name + machine hostname) instead of being
# configured. Fix: git config user.name / user.email, then
# `git commit --amend --reset-author` (or rebase with --reset-author).

ZERO="0000000000000000000000000000000000000000"
BAD=""

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue # branch deletion
  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086
  while IFS='|' read -r sha author_email committer_email; do
    for email in "$author_email" "$committer_email"; do
      domain="${email##*@}"
      case "$domain" in
        *.lan | *.local | *.localdomain | *.home | *.internal | localhost | "")
          BAD="$BAD\n  $sha  <$email>"
          ;;
        *.*) ;; # a real domain
        *)
          BAD="$BAD\n  $sha  <$email>" # bare hostname, no dot
          ;;
      esac
    done
  done < <(git rev-list --format='%h|%ae|%ce' --no-commit-header $range)
done

if [ -n "$BAD" ]; then
  printf 'pre-push: commits carry a machine-generated identity (hostname email):%b\n' "$BAD" >&2
  printf 'Set user.name / user.email, re-author those commits, then push again.\n' >&2
  exit 1
fi
