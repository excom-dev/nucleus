@use "quark:list" as list;
@use "quark:map" as map;

:scope {
  $chosen-delivery: list.find(
    $checkout.deliveryOptions,
    "id",
    $checkout.delivery
  );
  $chosen-payment: list.find($checkout.paymentOptions, "id", $checkout.payment);
  has-lines: $bag.count > 0;

  &:not([has-lines]) [bind-place-order] {
    disabled-reason: "Your bag is empty, so there is nothing to order.";
    button {
      disabled: "";
    }
  }
  &[has-lines] [bind-place-order] {
    disabled-reason: none;
    button {
      disabled: none;
    }
  }
}
[bind-checkout] {
  content: map.get($checkout, attr("bind-checkout"));
}
[bind-delivery] {
  content: $chosen-delivery[attr("bind-delivery")];
}
[bind-payment] {
  content: $chosen-payment[attr("bind-payment")];
}
