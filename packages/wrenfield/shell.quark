@use "quark:date" as date;
@use "quark:list" as list;
@use "quark:string" as *;
@use "quark:url" as url;

service-worker {
  has-controller: prop("provision").hasController;
  &[has-controller] ~ [bind-app] {
    is-active: "";
  }
  &:not([has-controller]) ~ [bind-app] {
    is-active: none;
  }
}
:scope:has(> detect-media[is-matched]) {
  data-layout: "compact";
}
:scope:not(:has(> detect-media[is-matched])) {
  data-layout: "regular";
}

#me {
  @on super-form-success, super-form-error {
    @command --fetch;
  }
  @on super-form-success (target: "super-form:has(> form[action='/api/bag'])") {
    @command --open (target: "#bag-sheet");
  }
  @on spa-manager-push, spa-manager-back, spa-manager-forward {
    content-drawer {
      is-open: none;
    }
  }

  &[did-load] {
    $me: prop("provision").body;
    $bag: $me.bag;
    $bag-skus: list.pluck($me.bag.items, "sku");
    $saved-skus: list.pluck($me.saved.items, "sku");
    is-trade: $me.isTrade;
    bag-count: $me.bag.count;
    saved-count: $me.saved.count;
  }

  > spa-manager {
    $query: prop("provision").query;
    [bind-search] input {
      value: $query.q or "";
    }
  }
}

spa-route {
  $route: prop("provision");
  @on view-title {
    document-title: "#{event.detail} · Wrenfield";
  }
}
spa-a[role] {
  tabindex: 0;
  @on keydown (key: "Enter") {
    @dispatch click;
  }
}
spa-a[role="button"] {
  @on keydown (key: "Space", prevent-default) {
    @dispatch click;
  }
}
header nav > spa-a {
  aria-current: if(attr("is-active") != null: "page"; else: none);
}
[bind-search] {
  @on input {
    route-href: "/shop?q=#{url.encode(event.target.value)}";
  }
}
[bind-saved-count] {
  content: $me.saved.count;
}
[bind-bag-count] {
  content: $bag.count;
}
[bind-bag]:not([bind-bag="deliveryFee"]) {
  is-zero: $bag[attr("bind-bag")] == 0;
  content: $bag["#{attr("bind-bag")}Text"];
}
[bind-bag="deliveryFee"] {
  content: if($bag.deliveryFee == 0: "Free"; else: $bag.deliveryFeeText);
}
[bind-item] {
  content: item[attr("bind-item")];
}
[bind-count] {
  content: plural($count, (one: "# piece", other: "# pieces"));
}
main provider-fetch {
  $response: prop("provision").body;
  [bind-error] {
    content: $response.message or "Please try again in a moment.";
  }
}

[bind-products] {
  content: iterate($products, "#product-card", "sku");
  > data-product {
    $product: item;
  }
}
data-product {
  category-slug: $product.category;
  is-new: $product.isNew;
  is-unique: $product.isUnique;
  is-sold: $product.isSold;
  is-saved: $saved-skus.includes($product.sku);
  is-in-bag: $bag-skus.includes($product.sku);

  [bind-product] {
    content: $product[attr("bind-product")];
  }
  [bind-product-link] {
    route-href: $product.href;
  }
  [bind-product-image] {
    src: $product.image;
  }
  [bind-price] {
    value: $product.price;
    content: $product.priceText;
  }
  [bind-trade-price] {
    value: $product.tradePrice;
    content: $product.tradePriceText;
  }
  [bind-save] {
    action: "/api/saved/#{$product.sku}";
  }
  &[is-saved] [bind-save] {
    method: "delete";
    button {
      aria-label: "Remove from saved";
    }
  }
  &:not([is-saved]) [bind-save] {
    method: "put";
    button {
      aria-label: "Save";
    }
  }
}

[bind-bag-lines] {
  content: iterate($bag.items, "#bag-line", "id");
}
data-line {
  is-unique: item.isUnique;
  line-qty: item.qty;

  [bind-line-link] {
    route-href: item.href;
  }
  [bind-line-image] {
    src: item.image;
  }
  [bind-line-finish] {
    content: item.finish.name;
    --swatch: item.finish.swatch;
  }
  [bind-line-lead] {
    content: if(
      item.leadWeeks: "Made to order, about #{item.leadWeeks} weeks";
      else: none
    );
  }
  [bind-line-hold] {
    content: if(
      item.heldUntil:
        "Held for you until #{date.format(item.heldUntil, "en-US", (timeStyle: "short"))}";
      else: none
    );
  }
  [bind-line-total] {
    value: item.lineTotal;
    content: item.lineTotalText;
  }
  form {
    action: "/api/bag/#{item.id}";
  }
  [bind-line-less] input {
    value: item.qty - 1;
  }
  [bind-line-more] input {
    value: item.qty + 1;
  }
}

content-drawer {
  :scope[data-layout="compact"] & {
    from-side: "bottom";
  }
  :scope[data-layout="regular"] & {
    from-side: "right";
  }
  &[is-open] dismiss-watcher {
    is-active: "";
  }
  &:not([is-open]) dismiss-watcher {
    is-active: none;
  }
}
:not(link, quark-sheet):has(~ gesture-handler > content-drawer[is-open]),
spa-manager:has(content-drawer[is-open]) > :is(header, footer) {
  inert: "";
}
:not(link, quark-sheet):has(~ gesture-handler > content-drawer:not([is-open])),
spa-manager:not(:has(content-drawer[is-open])) > :is(header, footer) {
  inert: none;
}
gesture-handler:has(> content-drawer) {
  :scope[data-layout="compact"] & {
    is-disabled: none;
  }
  :scope[data-layout="regular"] & {
    is-disabled: "";
  }
  &:has(> [is-open]) {
    progress-offset: 1;
  }
  &:not(:has(> [is-open])) {
    progress-offset: 0;
  }
  @on gesture-handler-start {
    content-drawer {
      is-scrubbing: "";
    }
  }
  @on gesture-handler-end {
    content-drawer {
      is-open: event.detail.snap == 1;
      is-scrubbing: none;
    }
  }
}
