# Copied into dist/ by the build. Code and pages revalidate, hashed assets/ never change,
# media and data cache for a day. Rules match request paths: a prerendered page is the
# slashless `.html` file of its path (`/shop/tables` is shop/tables.html).
/
  Cache-Control: no-cache
/shop
  Cache-Control: no-cache
/shop/*
  Cache-Control: no-cache
/saved
  Cache-Control: no-cache
/bag
  Cache-Control: no-cache
/bag/*
  Cache-Control: no-cache
/account
  Cache-Control: no-cache
/account/*
  Cache-Control: no-cache
# The worker is registered with scope `/` from below the root.
/service-worker/*
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/views/*
  Cache-Control: no-cache
/shell.quark
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=86400
/models/*
  Cache-Control: public, max-age=86400
/data/*
  Cache-Control: public, max-age=86400
