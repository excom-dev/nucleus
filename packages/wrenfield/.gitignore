# The root .gitignore drops packages/*/README.md (generated for published packages); this one is hand-written.
!README.md
support/tests/browser/shots
# Opt-in complexity snapshots (NUCLEUS_COMPLEXITY=1 pnpm test), never committed
support/tests/__snapshots__/
# Build output
dist/
# The prerender's cache and saved shell (heft-rig prerender.mjs)
temp/
