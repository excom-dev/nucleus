{
  "name": "wrenfield",
  "private": true,
  "version": "0.1.0",
  "description": "Wrenfield, a furniture house for made-to-order pieces, restored antiques, lighting and objects. Built on the Nucleus Stack with no backend: a service worker plays the API.",
  "license": "MIT",
  "engines": {
    "node": ">=24.13.0"
  },
  "type": "module",
  "scripts": {
    "build": "node node_modules/@excom/heft-rig/scripts/vite-build.mjs",
    "format": "node node_modules/@excom/heft-rig/scripts/format.mjs",
    "test": "node node_modules/@excom/heft-rig/scripts/vitest.mjs",
    "coverage": "node node_modules/@excom/heft-rig/scripts/coverage.mjs",
    "dev": "node node_modules/@excom/heft-rig/scripts/vite-dev.mjs",
    "preview": "node node_modules/@excom/heft-rig/scripts/vite-preview.mjs",
    "build:prerender": "node node_modules/@excom/heft-rig/scripts/prerender.mjs support/prerender/prerender.config.ts"
  },
  "dependencies": {
    "@excom/nucleus-kit": "workspace:^"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@excom/heft-rig": "workspace:^",
    "@excom/nucleus-dom": "workspace:^",
    "@excom/nucleus-ssr": "workspace:^",
    "@excom/nucleus-test": "workspace:^",
    "@excom/spa-route": "workspace:^",
    "@excom/vite-plugin-nucleus": "workspace:^"
  },
  "bugs": "https://github.com/excom-dev/nucleus/issues",
  "keywords": [
    "wrenfield",
    "app"
  ],
  "excom": {
    "documented": false,
    "packageType": "app"
  }
}
