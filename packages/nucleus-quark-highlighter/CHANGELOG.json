      "comments": {
        "patch": [
          {
            "comment": "Fix highlighting after a bare word directly before a closing bracket, as in `if($a: 1; else: preserve)`: the rest of the sheet was coloured as one value. Remove the `///` documentation comment rule: Quark has only `/* … */` comments, so a `///` line is no longer coloured as one in the editor"
          }
        ]
