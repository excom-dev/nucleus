# Cloudflare Pages negotiates Brotli (br) then gzip from Accept-Encoding.
# Vary keeps the two encodings in separate cache entries.
/*
  Vary: Accept-Encoding

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sandbox.html
  Cache-Control: public, max-age=0, must-revalidate

/code-editor.css
  Cache-Control: public, max-age=0, must-revalidate

/views/*
  Cache-Control: public, max-age=0, must-revalidate

/fragments/*
  Cache-Control: public, max-age=0, must-revalidate

/shell.js
  Cache-Control: public, max-age=0, must-revalidate

/demo-utils.js
  Cache-Control: public, max-age=0, must-revalidate

/service-worker/*
  Cache-Control: no-store
  Service-Worker-Allowed: /

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/package-metas/*
  Cache-Control: public, max-age=0, must-revalidate

/llms.txt
  Cache-Control: public, max-age=0, must-revalidate

/llms-full.txt
  Cache-Control: public, max-age=0, must-revalidate

/*.md
  Cache-Control: public, max-age=0, must-revalidate

/docs/*
  Cache-Control: public, max-age=0, must-revalidate

# Icons and the social card have stable, unhashed names: a day's cache, not immutable.
# Named rather than `/*.png`, which would also match hashed `/assets/*.png` and
# append a second, conflicting Cache-Control to its immutable one.
/favicon.ico
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/icon-*.png
  Cache-Control: public, max-age=86400

/og-image.png
  Cache-Control: public, max-age=86400
