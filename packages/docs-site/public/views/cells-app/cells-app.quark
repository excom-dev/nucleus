/* State: each <td data-formula> holds its cell's committed text; the form's
   data-revision counts commits. Only formula cells derive a value, and only
   when the revision changes. A cell's <input> is `readonly` until it is
   opened for editing. */
@use "/views/cells-app/cells-app.js" as *;

:scope {
  $columns: " ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
  @on change (handle: commit);
  /* a double-click opens the focused cell, as do Enter / F2 */
  @on dblclick (target: "input[readonly]") {
    input:focus {
      readonly: none;
    }
  }
  @on keydown (target: "input[readonly]", key: "Enter F2") {
    input:focus {
      readonly: none;
    }
  }
  /* Enter, or leaving the cell, closes it */
  @on keydown (target: "input:not([readonly])", key: "Enter") {
    input:not([readonly]) {
      readonly: "";
    }
  }
  @on focusout (target: "input:not([readonly])") {
    input:not([readonly]) {
      readonly: "";
    }
  }

  form {
    @on submit (prevent-default);
  }
  thead tr {
    content: iterate($columns);
    th {
      content: item;
    }
  }
  tbody {
    content: iterate(range(100));
  }
  tbody tr {
    $row: index;
    content: iterate($columns.slice(1));
  }
  tbody td {
    $ref: "#{item}#{$row}";
    input {
      name: $ref;
    }
  }
  form[data-revision] td[data-formula^="="] output {
    content: evalCell(closest("td"));
  }
  td[data-formula]:not([data-formula^="="]) output {
    content: none;
  }
}
