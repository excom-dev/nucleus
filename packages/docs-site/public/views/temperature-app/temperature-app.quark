/* State: the last entry on the host, `data-entry` (the field's value) and
   `data-unit` (the field's name). A number field's value is "" while its text
   is empty or not a number: no rule matches then, so the other field keeps
   what it shows. */
:scope {
  @on input {
    data-entry: event.target.value;
    data-unit: event.target.name;
  }
}
:scope[data-unit="celsius"]:not([data-entry=""]) {
  $celsius: attr("data-entry");
  [bind-fahrenheit] input {
    value: ($celsius * 9 / 5 + 32).toFixed(1);
  }
}
:scope[data-unit="fahrenheit"]:not([data-entry=""]) {
  $fahrenheit: attr("data-entry");
  [bind-celsius] input {
    value: (($fahrenheit - 32) * 5 / 9).toFixed(1);
  }
}
