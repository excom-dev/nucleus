/* Scoped to .live-app. The nearest [data-app] ancestor (a spa-route, or any
   host such as the Introduction page's aside) carries the example app's view
   name on [data-app] and its editable file extensions on [data-files].
   Files are read / saved through the service worker's /api/sandbox overlay;
   the preview iframe (/sandbox/<app>) is rebuilt by the `--reload` command
   after every save or reset (wired in the HTML). `$app` and `$files` are
   also read by the editors' own sheet (inline in live-app.html). No `@use`
   here: the preview waits for no module. */

:scope {
  $app: closest("[data-app]").getAttribute("data-app");
  $files: closest("[data-app]").getAttribute("data-files").split(" ");

  .imported-header > include-content {
    template-ref: "/views/demo-headers/#{$app}.html";
    is-active: "";
  }
  /* preview renders once the mount-time DELETE settled (error too: no worker, still show the app),
     and only on screen: the frame is a second document, with a boot of its own */
  &:has(provider-fetch.fresh:is([is-success], [is-error])) [aria-label="preview"] include-content {
    lazy-load: "";
  }
  [aria-label="preview"] iframe {
    src: "/sandbox/#{$app}";
  }

  /* Every mount drops the app's saved edits; the editors may render once that succeeded.
     Paused until the `service-worker` observer before it mounts, which a prerender never does. */
  provider-fetch.fresh {
    api-url: "/api/sandbox/views/#{$app}";
  }
  service-worker[is-mounted] + provider-fetch.fresh {
    is-paused: none;
  }
  service-worker:not([is-mounted]) + provider-fetch.fresh {
    is-paused: "";
  }

  [bind-file-headers] {
    content: iterate($files);
    content-tabs-header {
      tab-name: item;
      data-file-type: item;
      [bind-file-name] {
        content: "#{$app}.#{item}";
      }
    }
  }
  /* The editors load once on screen: beside the preview on a wide viewport, in the
     opened sheet on a narrow one. Their sheet (live-app.html) loads the highlighter. */
  provider-fetch.fresh[is-success] [bind-editors] {
    lazy-load: "";
  }
  /* The Code button and ✕ address the editor sheet by id (native command API). */
  [aria-label="editor"] {
    id: "editor-#{$app}";
    &[is-open] dismiss-watcher {
      is-active: "";
    }
    &:not([is-open]) dismiss-watcher {
      is-active: none;
    }
  }
  .editor-toggle,
  [aria-label="editor"] > .close {
    commandfor: "editor-#{$app}";
  }
  /* grabber drag */
  gesture-handler {
    &:has(> [aria-label="editor"][is-open]) {
      progress-offset: 1;
    }
    &:not(:has(> [aria-label="editor"][is-open])) {
      progress-offset: 0;
    }
    @on gesture-handler-start {
      [aria-label="editor"] {
        is-scrubbing: "";
      }
    }
    @on gesture-handler-end {
      [aria-label="editor"] {
        is-open: event.detail.snap == 1;
        is-scrubbing: none;
      }
    }
  }
  /* First file opens by default; idempotent once any tab is open. */
  content-tabs:not(:has(content-tabs-header[is-open])) content-tabs-header:first-of-type,
  content-tabs:not(:has(content-tabs-body[is-open])) content-tabs-body:first-of-type {
    is-open: "";
  }
}
